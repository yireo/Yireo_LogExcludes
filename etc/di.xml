<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Logger\Monolog">
        <plugin
            name="Yireo_LogExcludes::excludeMessage"
            type="Yireo\LogExcludes\Plugin\ExcludeMessagePlugin"
        />
    </type>

    <type name="Yireo\LogExcludes\Config\Backend\Patterns">
        <arguments>
            <argument name="authSession" xsi:type="object">Magento\Backend\Model\Auth\Session\Proxy</argument>
        </arguments>
    </type>
</config>
